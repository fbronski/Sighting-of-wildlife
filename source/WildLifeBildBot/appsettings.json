{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],

    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "widllifebildbot.txt" },
        "rollingInterval": "Day"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "WildLifeBildBot"
    }
  },
  "ApplicationSettings": {
    "DBType": "SqliteDB",
    "FTPHomePath": "C:\\Temp\\SpybildBot",
    "BotHomePath": "C:\\Temp\\SpybildBot",
    "ImmichApiClientKey": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
    "ImmichEndPoint": "https://test.wildbild.cloud/api",
    "ImmichUserId": "XXXXXXXXXXXXXXXXXXXXXXX"
  }
}
